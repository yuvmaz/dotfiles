" Legacy Vim config retired.
" Current editor configuration lives in ~/.config/nvim.

set nocompatible
syntax on
filetype plugin indent on
set number
set encoding=utf-8
set backspace=indent,eol,start
let mapleader = ";"

echohl WarningMsg
echom "Legacy ~/.vim/vimrc is retired; use Neovim (~/.config/nvim)."
echohl None
